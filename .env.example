# Reference list of the environment variables MobiMix reads. All are optional: the defaults
# work for local development. Nothing loads a .env file automatically - set them in the shell,
# e.g. in PowerShell:   $env:MOBIMIX_DATA_DIR = "C:\path\to\my\data"

# --- backend ---------------------------------------------------------------------------
# Folder with the editable reference data (YAML). Default: <repo>/data
# MOBIMIX_DATA_DIR=

# Browser origins allowed to call the API (comma separated). Default: the Vite dev server.
# MOBIMIX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Folder with the built web app (frontend/dist). When set, the server serves the web app too, from
# the same address as the API - this is how it runs when published (see the Dockerfile).
# MOBIMIX_STATIC_DIR=

# --- frontend dev server (read by frontend/vite.config.ts) -----------------------------
# Where /api is proxied. Default: http://127.0.0.1:8000
# MOBIMIX_API_URL=http://127.0.0.1:8000
